@app.get("/admin/forensic/snapshot")
async def forensic_snapshot(request: Request):
    """Point-in-time forensic snapshot of entire system state. Admin-only.
    Used for incident investigation and compliance audits."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    snapshot_id = f"SNAP-{str(uuid.uuid4())[:8].upper()}"
    now = datetime.now(timezone.utc)

    snapshot = {
        "snapshot_id": snapshot_id,
        "captured_at": now.isoformat(),
        "captured_by": user["user_id"],
        "system_state": {
            "version": "2.0.0",
            "environment": os.getenv("ASON_ENV", "development"),
            "uptime_seconds": round(time.time() - _sla_tracker["start_time"], 0),
            "shutting_down": _shutting_down,
        },
        "security_posture": {
            "circuit_breaker": inference_circuit_breaker.to_dict(),
            "active_incidents": sum(1 for i in _incidents if i["status"] == "ACTIVE"),
            "canary_alerts": len(_canary_alerts),
            "dlp_detections": sum(_DLP_STATS.values()),
            "audit_chain_status": audit_logger.verify_chain(),
            "total_audit_events": len(audit_logger.logs),
        },
        "resource_state": {
            "active_jobs": len([j for j in job_store.get_all_jobs() if j.get("status") in ["RUNNING", "QUEUED"]]) if hasattr(job_store, 'get_all_jobs') else 0,
            "total_jobs": len(job_store.get_all_jobs()) if hasattr(job_store, 'get_all_jobs') else 0,
            "documents_indexed": len(document_store._documents),
            "active_ws_connections": sum(len(c) for c in ws_connections.values()),
        },
        "performance_snapshot": {
            "total_requests": _sla_tracker["successes"] + _sla_tracker["failures"],
            "success_rate": round(
                _sla_tracker["successes"] / max(1, _sla_tracker["successes"] + _sla_tracker["failures"]), 6
            ),
            "p99_ms": round(sorted(_sla_tracker["latencies_ms"])[int(len(_sla_tracker["latencies_ms"]) * 0.99)], 2)
                     if len(_sla_tracker["latencies_ms"]) > 10 else 0,
            "metered_tenants": len(_usage_store),
        },
        "threat_intelligence": {
            "threat_level": "HIGH" if len(_canary_alerts) > 0 else "LOW",
            "mitre_techniques_observed": len(set(
                mitre["technique"] for action in [e.get("action", "") for e in audit_logger.logs]
                for event_type, mitre in _MITRE_ATTACK_MAP.items()
                if event_type.lower() in action.lower()
            )),
        },
    }

    # Sign the snapshot
    snapshot["integrity"] = {
        "algorithm": "SHA-256",
        "hash": hashlib.sha256(
            json.dumps(snapshot, sort_keys=True, default=str).encode()
        ).hexdigest(),
    }

    audit_logger.log(user["user_id"], "FORENSIC_SNAPSHOT", snapshot_id, "COMPLETED")

    return snapshot


# --- Segregation of Duties Matrix ---
_SEGREGATION_RULES = {
    "cannot_self_approve": {
        "action_a": "INCIDENT_DECLARED",
        "action_b": "INCIDENT_RESOLVED",
        "rule": "Incident declarer cannot resolve their own incident",
    },
    "cannot_self_audit": {
        "action_a": "COMPLIANCE_EVIDENCE_EXPORT",
        "action_b": "SIGNED_AUDIT_EXPORT",
        "rule": "Same user should not export compliance evidence and sign audit in same session",
    },
}


@app.get("/admin/governance/segregation")
async def segregation_of_duties(request: Request):
    """Segregation of duties report. Shows where single users have dual control."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    violations = []
    user_actions: Dict[str, Set[str]] = defaultdict(set)

    for event in audit_logger.logs:
        user_actions[event.get("user", "unknown")].add(event.get("action", ""))

    for rule_id, rule in _SEGREGATION_RULES.items():
        for uid, actions in user_actions.items():
            if rule["action_a"] in actions and rule["action_b"] in actions:
                violations.append({
                    "rule_id": rule_id,
                    "user": uid,
                    "rule": rule["rule"],
                    "actions_found": [rule["action_a"], rule["action_b"]],
                })

    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "rules_checked": len(_SEGREGATION_RULES),
        "violations_found": len(violations),
        "violations": violations,
        "rules": _SEGREGATION_RULES,
        "status": "CLEAN" if not violations else "VIOLATIONS_DETECTED",
    }


@app.get("/admin/governance/key-rotation")
async def key_rotation_status(request: Request):
    """Track key/secret rotation status. Admin-only."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    now = datetime.now(timezone.utc)
    keys = [
        {
            "key_name": "HMAC_SIGNING_SECRET",
            "purpose": "Response signing & audit chain HMAC",
            "is_default": _HMAC_SECRET == hashlib.sha256(b"ason-lc1-default-dev-key").hexdigest(),
            "rotation_required": _HMAC_SECRET == hashlib.sha256(b"ason-lc1-default-dev-key").hexdigest(),
            "recommendation": "Set ASON_HMAC_SECRET env var with a cryptographically random 256-bit key",
        },
        {
            "key_name": "JWT_SIGNING_KEY",
            "purpose": "Keycloak OIDC token verification",
            "is_default": False,  # Managed by Keycloak
            "rotation_required": False,
            "recommendation": "Managed by Keycloak realm — rotate via Keycloak admin console",
        },
        {
            "key_name": "TLS_CERTIFICATE",
            "purpose": "HTTPS transport encryption",
            "is_default": os.getenv("ASON_TLS_ENABLED", "false").lower() != "true",
            "rotation_required": os.getenv("ASON_TLS_ENABLED", "false").lower() != "true",
            "recommendation": "Deploy TLS certificate via infra/security/mtls-config.md",
        },
    ]

    all_rotated = all(not k["rotation_required"] for k in keys)

    return {
        "timestamp": now.isoformat(),
        "overall_status": "ALL KEYS CURRENT" if all_rotated else "ROTATION REQUIRED",
        "keys": keys,
        "total_keys": len(keys),
        "needing_rotation": sum(1 for k in keys if k["rotation_required"]),
    }


@app.get("/admin/governance/compliance-calendar")
async def compliance_calendar(request: Request):
    """Upcoming compliance deadlines and audit schedule. Admin-only."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    now = datetime.now(timezone.utc)
    calendar = [
        {
            "event": "SOC 2 Type II Annual Audit",
