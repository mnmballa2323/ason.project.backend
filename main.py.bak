# ============================================================================
#  BULK JOB STATUS
# ============================================================================

class BulkStatusRequest(BaseModel):
    job_ids: List[str]


@app.post("/verify/status/bulk")
async def bulk_job_status(req: BulkStatusRequest, request: Request):
    """Check status of multiple jobs in a single request."""
    user = await verify_jwt(request)
    require_role(user, "bulk_status")

    if len(req.job_ids) > 100:
        raise HTTPException(status_code=422, detail="Max 100 job IDs per bulk request.")

    results = {}
    for jid in req.job_ids:
        record = await job_store.get(jid)
        if record:
            results[jid] = {"status": record.get("status"), "industry": record.get("industry"),
                           "progress": record.get("progress"), "started_at": record.get("started_at"),
                           "completed_at": record.get("completed_at"), "tags": record.get("tags", {})}
        else:
            results[jid] = {"status": "not_found"}

    return {"total": len(req.job_ids), "found": sum(1 for v in results.values() if v["status"] != "not_found"), "jobs": results}


# ============================================================================
#  PROMETHEUS METRICS EXPORT (Pure Python — No prometheus_client dependency)
# ============================================================================

def _prometheus_format() -> str:
    """Generate Prometheus text exposition format from internal metrics."""
    lines = []
    # --- Job counters ---
    lines.append("# HELP ason_jobs_total Total verification jobs by status")
    lines.append("# TYPE ason_jobs_total counter")
    # Count jobs by status from in-memory store
    status_counts: Dict[str, int] = defaultdict(int)
    for record in (job_store._jobs.values() if hasattr(job_store, '_jobs') else []):
        s = record.get("status", "unknown") if isinstance(record, dict) else "unknown"
        status_counts[s] += 1
    for status, count in status_counts.items():
        lines.append(f'ason_jobs_total{{status="{status}"}} {count}')

    # --- In-flight gauge ---
    lines.append("# HELP ason_inflight_jobs Currently running jobs")
    lines.append("# TYPE ason_inflight_jobs gauge")
    active = sum(1 for v in _inflight_jobs.values() if v)
    lines.append(f"ason_inflight_jobs {active}")

    # --- Circuit breaker ---
    lines.append("# HELP ason_circuit_breaker_open 1 if circuit breaker is open")
    lines.append("# TYPE ason_circuit_breaker_open gauge")
    cb_open = 1 if inference_circuit_breaker.state == "open" else 0
    lines.append(f"ason_circuit_breaker_open {cb_open}")

    # --- Audit chain ---
    lines.append("# HELP ason_audit_events_total Total audit events logged")
    lines.append("# TYPE ason_audit_events_total counter")
    lines.append(f"ason_audit_events_total {len(audit_logger.logs)}")

    # --- Pipeline execution metrics ---
    pipe_metrics = verification_pipeline.get_metrics()
    lines.append("# HELP ason_pipeline_runs_total Total pipeline executions")
    lines.append("# TYPE ason_pipeline_runs_total counter")
    lines.append(f'ason_pipeline_runs_total {pipe_metrics.get("total_runs", 0)}')

    lines.append("# HELP ason_pipeline_duration_seconds Pipeline execution duration")
    lines.append("# TYPE ason_pipeline_duration_seconds gauge")
    avg_ms = pipe_metrics.get("average_duration_ms", 0)
    lines.append(f"ason_pipeline_duration_seconds {avg_ms / 1000.0:.6f}")

    # --- Inference agent ---
    agent_stats = ason_agent.get_stats()
    lines.append("# HELP ason_inference_calls_total Total inference calls")
    lines.append("# TYPE ason_inference_calls_total counter")
    lines.append(f'ason_inference_calls_total {agent_stats.get("total_calls", 0)}')

    lines.append("# HELP ason_inference_errors_total Total inference errors")
    lines.append("# TYPE ason_inference_errors_total counter")
    lines.append(f'ason_inference_errors_total {agent_stats.get("errors", 0)}')

    # --- Rate limit ---
    lines.append("# HELP ason_rate_limited_ips Number of IPs currently tracked")
    lines.append("# TYPE ason_rate_limited_ips gauge")
    lines.append(f"ason_rate_limited_ips {len(rate_limit_store)}")

    return "\n".join(lines) + "\n"


@app.get("/metrics")
async def prometheus_metrics():
    """Prometheus-compatible metrics endpoint for Grafana/AlertManager scraping."""
    from fastapi.responses import Response
    return Response(
        content=_prometheus_format(),
        media_type="text/plain; version=0.0.4; charset=utf-8",
    )


# ============================================================================
#  SOFTWARE BILL OF MATERIALS (EO 14028 Compliance)
# ============================================================================

_SBOM_CACHE: Optional[dict] = None


def _generate_sbom() -> dict:
    """Generate CycloneDX-style SBOM from requirements.txt and runtime info."""
    global _SBOM_CACHE
    if _SBOM_CACHE:
        return _SBOM_CACHE

    components = []
    # Parse requirements.txt if available
    req_path = os.path.join(os.path.dirname(__file__), "requirements.txt")
    if os.path.exists(req_path):
        with open(req_path, "r") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    parts = line.split("==")
                    name = parts[0].strip()
                    version = parts[1].strip() if len(parts) > 1 else "*"
                    components.append({"name": name, "version": version, "type": "library", "scope": "required"})

    # Hardcoded runtime dependencies (always present)
    runtime = [
        {"name": "python", "version": f"{os.sys.version_info.major}.{os.sys.version_info.minor}.{os.sys.version_info.micro}", "type": "platform"},
        {"name": "fastapi", "version": "0.104+", "type": "framework"},
        {"name": "httpx", "version": "0.25+", "type": "library"},
        {"name": "pydantic", "version": "2.0+", "type": "library"},
        {"name": "tenacity", "version": "8.0+", "type": "library"},
    ]

    _SBOM_CACHE = {
        "bomFormat": "CycloneDX",
        "specVersion": "1.5",
        "version": 1,
        "metadata": {
            "component": {
                "name": "ason-verification-orchestrator",
                "version": "2.0.0",
                "type": "application",
                "supplier": "Liberty Center One",
            },
            "generated_at": datetime.now(timezone.utc).isoformat(),
        },
        "components": runtime + components,
        "totalComponents": len(runtime) + len(components),
        "externalApis": "NONE — fully self-hosted",
        "telemetry": "NONE — zero data exfiltration",
    }
    return _SBOM_CACHE


@app.get("/system/sbom")
async def get_sbom(request: Request):
    """Software Bill of Materials — EO 14028 compliance. Admin-only."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")
    return _generate_sbom()


# ============================================================================
#  OPERATIONAL DASHBOARD (Single Pane of Glass)
# ============================================================================

@app.get("/system/dashboard")
async def operational_dashboard(request: Request):
    """Combined operational dashboard data. Admin-only."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    # --- Job statistics ---
    all_jobs = await job_store.list_all()
    status_breakdown: Dict[str, int] = defaultdict(int)
    tenant_breakdown: Dict[str, int] = defaultdict(int)
    for job in all_jobs:
        s = job.get("status", "unknown") if isinstance(job, dict) else "unknown"
        status_breakdown[s] += 1
        t = job.get("tenant_id", "default") if isinstance(job, dict) else "default"
        tenant_breakdown[t] += 1

    # Top tenants by volume
    top_tenants = sorted(tenant_breakdown.items(), key=lambda x: x[1], reverse=True)[:10]

    # --- System health ---
    active_jobs = sum(1 for v in _inflight_jobs.values() if v)

    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "jobs": {
            "total": len(all_jobs),
            "by_status": dict(status_breakdown),
            "inflight": active_jobs,
            "top_tenants": [{"tenant": t, "jobs": c} for t, c in top_tenants],
        },
        "pipeline": verification_pipeline.get_metrics(),
        "inference": ason_agent.get_stats(),
        "circuit_breaker": inference_circuit_breaker.to_dict(),
        "audit": {
            "total_events": len(audit_logger.logs),
            "chain_integrity": audit_logger.verify_chain(),
        },
        "rate_limiting": {
            "tracked_ips": len(rate_limit_store),
            "config": f"{RATE_LIMIT_MAX}/{RATE_LIMIT_WINDOW}s",
        },
        "security": {
            "ip_allowlist_enabled": len(IP_ALLOWLIST) > 0,
            "rbac_enforced": True,
            "auth_provider": "Keycloak (self-hosted)",
        },
    }


# ============================================================================
#  TENANT DATA EXPORT (GDPR Art. 20 — Data Portability)
# ============================================================================

class TenantExportRequest(BaseModel):
    tenant_id: str


@app.post("/admin/export/tenant")
async def export_tenant_data(req: TenantExportRequest, request: Request):
    """Export all data for a tenant — GDPR Article 20 compliance. Admin-only."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    audit_logger.log(user["user_id"], "TENANT_DATA_EXPORT", req.tenant_id, "INITIATED")

    # Collect all jobs for tenant
    all_jobs = await job_store.list_all()
    tenant_jobs = [
        job for job in all_jobs
        if isinstance(job, dict) and job.get("tenant_id") == req.tenant_id
    ]

    # Collect audit events for tenant
    tenant_events = [
        event for event in audit_logger.logs
        if event.get("actor", "").startswith(req.tenant_id)
        or event.get("target", "") in [j.get("job_id", "") for j in tenant_jobs]
    ]

    export_hash = hashlib.sha256(
        json.dumps({"tenant": req.tenant_id, "jobs": len(tenant_jobs), "events": len(tenant_events)}, sort_keys=True).encode()
    ).hexdigest()

    audit_logger.log(user["user_id"], "TENANT_DATA_EXPORT", req.tenant_id, "COMPLETED",
                     {"jobs": len(tenant_jobs), "events": len(tenant_events)})

    return {
        "export_format": "ason-tenant-export-v1",
        "tenant_id": req.tenant_id,
        "exported_at": datetime.now(timezone.utc).isoformat(),
        "exported_by": user["user_id"],
        "jobs": {
            "total": len(tenant_jobs),
            "records": tenant_jobs,
        },
        "audit_events": {
            "total": len(tenant_events),
            "events": tenant_events,
        },
        "attestation": {
            "hash": export_hash,
            "statement": f"Complete data export for tenant '{req.tenant_id}'. "
                         "No data was transmitted externally. Export generated on-premise.",
        },
    }


