# ============================================================================
#  WAVE 38 — SELF-SERVICE ONBOARDING API
# ============================================================================

@app.post("/onboard/tenant")
async def onboard_tenant(request: Request):
    """Provision a new tenant — self-service day-1 setup."""
    body = await request.json()
    tenant_name = body.get("name", "").strip()
    admin_email = body.get("admin_email", "").strip()
    plan = body.get("plan", "professional")

    if not tenant_name or len(tenant_name) < 2:
        return JSONResponse({"error": "Tenant name required (min 2 chars)"}, status_code=400)
    if not admin_email or "@" not in admin_email:
        return JSONResponse({"error": "Valid admin email required"}, status_code=400)

    tenant_id = str(uuid.uuid4())
    api_key = f"qw_{hashlib.sha256(f'{tenant_id}{time.time()}'.encode()).hexdigest()[:32]}"

    plan_config = {
        "starter": {"max_verifications_day": 100, "max_models": 3, "sla_tier": "standard", "support": "email"},
        "professional": {"max_verifications_day": 1000, "max_models": 10, "sla_tier": "premium", "support": "priority"},
        "enterprise": {"max_verifications_day": -1, "max_models": -1, "sla_tier": "platinum", "support": "dedicated"},
    }

    config = plan_config.get(plan, plan_config["professional"])

    tenant = {
        "tenant_id": tenant_id,
        "name": tenant_name,
        "admin_email": admin_email,
        "plan": plan,
        "status": "ACTIVE",
        "created_at": datetime.now(timezone.utc).isoformat(),
        "api_key": api_key,
        "config": config,
        "onboarding_status": {
            "tenant_created": True,
            "api_key_generated": True,
            "first_verification": False,
            "compliance_configured": False,
            "team_invited": False,
        },
    }

    AUDIT_TRAIL.append({
        "event": "TENANT_ONBOARDED",
        "tenant_id": tenant_id,
        "name": tenant_name,
        "plan": plan,
        "timestamp": datetime.now(timezone.utc).isoformat(),
    })

    return {
        "status": "PROVISIONED",
        "tenant": tenant,
        "quickstart_url": f"/onboard/quickstart?tenant_id={tenant_id}",
        "next_steps": [
            "Save your API key securely — it will not be shown again",
            f"Visit /onboard/quickstart?tenant_id={tenant_id} for setup guide",
            "Submit your first verification at POST /verify/run",
            "Configure compliance at /admin/compliance/frameworks",
        ],
    }


@app.post("/onboard/api-keys")
async def onboard_api_keys(request: Request):
    """Generate API credentials for a tenant."""
    body = await request.json()
    tenant_id = body.get("tenant_id", "")
    key_name = body.get("name", "default")
    scopes = body.get("scopes", ["verify:read", "verify:write", "model:read"])

    if not tenant_id:
        return JSONResponse({"error": "tenant_id required"}, status_code=400)

    key_id = f"qwk_{hashlib.sha256(f'{tenant_id}{key_name}{time.time()}'.encode()).hexdigest()[:24]}"
    key_secret = hashlib.sha256(f'{key_id}{uuid.uuid4()}'.encode()).hexdigest()

    return {
        "key_id": key_id,
        "key_secret": key_secret,
        "name": key_name,
        "tenant_id": tenant_id,
        "scopes": scopes,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "expires_at": None,
        "warning": "Store the key_secret securely. It cannot be retrieved after this response.",
    }


