_V1_DEPRECATION_HEADERS = {
    "Deprecation": "true",
    "Sunset": "2027-01-01T00:00:00Z",
    "Link": '</v2/verify/run>; rel="successor-version"',
}


def _v1_response(result):
    """Wrap a v1 response with deprecation headers."""
    if isinstance(result, JSONResponse):
        for k, v in _V1_DEPRECATION_HEADERS.items():
            result.headers[k] = v
        return result
    resp = JSONResponse(content=result, status_code=200)
    for k, v in _V1_DEPRECATION_HEADERS.items():
        resp.headers[k] = v
    return resp


@app.post("/v1/verify/run", status_code=202)
async def v1_start_verification(req: VerificationRequest, request: Request, background_tasks: BackgroundTasks):
    """v1 alias for /verify/run. Deprecated — use /verify/run."""
    result = await start_verification(req, request, background_tasks)
    return _v1_response(result)


