# ============================================================================
#  CIRCUIT BREAKER (Pure Python — Prevents Cascading Failures)
# ============================================================================

class CircuitBreaker:
    """Pure Python circuit breaker. Opens after consecutive failures, auto-resets after cooldown."""

    def __init__(self, failure_threshold: int = 5, cooldown_seconds: int = 60):
        self.failure_threshold = failure_threshold
        self.cooldown_seconds = cooldown_seconds
        self._failures = 0
        self._last_failure_time = 0.0
        self._state = "closed"  # closed | open | half_open

    @property
    def state(self) -> str:
        if self._state == "open":
            if time.time() - self._last_failure_time > self.cooldown_seconds:
                self._state = "half_open"
        return self._state

    def record_success(self):
        self._failures = 0
        self._state = "closed"

    def record_failure(self):
        self._failures += 1
        self._last_failure_time = time.time()
        if self._failures >= self.failure_threshold:
            self._state = "open"
            logger.critical(f"Circuit breaker OPEN after {self._failures} consecutive failures")

    def allow_request(self) -> bool:
        state = self.state
        if state == "closed":
            return True
        if state == "half_open":
            return True  # Allow one probe request
        return False

    def to_dict(self) -> dict:
        return {
            "state": self.state,
            "consecutive_failures": self._failures,
            "threshold": self.failure_threshold,
            "cooldown_seconds": self.cooldown_seconds,
        }


inference_circuit_breaker = CircuitBreaker(failure_threshold=5, cooldown_seconds=60)


# ============================================================================
#  ASON DOCUMENT STORE (Pure Python — TF-IDF Scoring)
# ============================================================================

class AsonDocumentStore:
    """In-memory document store with TF-IDF scoring. Production: Milvus @ 10.0.42.0/24."""

    def __init__(self):
        self._documents: List[Dict[str, Any]] = []
        self._doc_freq: Dict[str, int] = {}  # term -> number of docs containing it

    def add(self, text: str, metadata: dict = None):
        doc = {"text": text, "metadata": metadata or {}}
        self._documents.append(doc)
        # Update document frequency index
        unique_terms = set(text.lower().split())
        for term in unique_terms:
            self._doc_freq[term] = self._doc_freq.get(term, 0) + 1

    async def search(self, query: str, top_k: int = 3) -> List[Dict[str, Any]]:
        """TF-IDF scored retrieval. Returns top_k matching documents."""
        query_terms = query.lower().split()
        n_docs = len(self._documents)
        if n_docs == 0:
            return []

        scored = []
        for doc in self._documents:
            doc_text = doc["text"].lower()
            doc_words = doc_text.split()
            doc_len = len(doc_words) if doc_words else 1
            score = 0.0

            for term in query_terms:
                # Term frequency (normalized by doc length)
                tf = doc_words.count(term) / doc_len
                # Inverse document frequency
                df = self._doc_freq.get(term, 0)
                idf = math.log((n_docs + 1) / (df + 1)) + 1  # Smoothed IDF
                score += tf * idf

            if score > 0:
                scored.append((score, doc))

        scored.sort(key=lambda x: x[0], reverse=True)
        return [doc for _, doc in scored[:top_k]]


document_store = AsonDocumentStore()
