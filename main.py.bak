@app.get("/admin/tenants/health")
async def tenant_health_dashboard(request: Request):
    """Tenant health scoring — engagement, error rates, churn risk.
    Critical for customer success and retention."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    tenant_health = []

    for tenant_id, usage in _usage_store.items():
        requests = usage["total_requests"]
        last_seen = usage.get("last_seen")
        first_seen = usage.get("first_seen")

        # Calculate recency (hours since last activity)
        recency_hours = 0
        if last_seen:
            try:
                last = datetime.fromisoformat(last_seen)
                recency_hours = (datetime.now(timezone.utc) - last).total_seconds() / 3600
            except (ValueError, TypeError):
                recency_hours = 999

        # Calculate tenure (days since first seen)
        tenure_days = 0
        if first_seen:
            try:
                first = datetime.fromisoformat(first_seen)
                tenure_days = (datetime.now(timezone.utc) - first).total_seconds() / 86400
            except (ValueError, TypeError):
                tenure_days = 0

        # Health scoring (0-100)
        health_score = 100

        # Engagement penalty
        if recency_hours > 168:  # No activity in 7 days
            health_score -= 40
        elif recency_hours > 72:  # No activity in 3 days
            health_score -= 20
        elif recency_hours > 24:
            health_score -= 10

        # Volume penalty (very low usage = at risk)
        if requests < 10:
            health_score -= 20
        elif requests < 50:
            health_score -= 10

        # Churn risk classification
        if health_score >= 80:
            churn_risk = "LOW"
        elif health_score >= 50:
            churn_risk = "MEDIUM"
        else:
            churn_risk = "HIGH"

        health_score = max(0, min(100, health_score))

        tenant_health.append({
            "tenant_id": tenant_id,
            "health_score": health_score,
            "churn_risk": churn_risk,
            "engagement": {
                "total_requests": requests,
                "endpoints_used": len(usage.get("endpoints", {})),
                "last_seen": last_seen,
                "recency_hours": round(recency_hours, 1),
                "tenure_days": round(tenure_days, 1),
            },
        })

    tenant_health.sort(key=lambda x: x["health_score"])

    # Summary stats
    at_risk = sum(1 for t in tenant_health if t["churn_risk"] == "HIGH")
    healthy = sum(1 for t in tenant_health if t["churn_risk"] == "LOW")

    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "total_tenants": len(tenant_health),
        "summary": {
            "healthy": healthy,
            "at_risk": at_risk,
            "avg_health_score": round(
                sum(t["health_score"] for t in tenant_health) / max(1, len(tenant_health)), 1
            ),
        },
        "tenants": tenant_health,
    }


@app.get("/admin/business/dashboard")
async def executive_business_dashboard(request: Request):
    """Executive business intelligence dashboard. Admin-only.
    Single view for CEO/CFO with revenue, health, security, and compliance."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    now = datetime.now(timezone.utc)
    total_requests = _sla_tracker["successes"] + _sla_tracker["failures"]
    success_rate = _sla_tracker["successes"] / max(1, total_requests)

    # Revenue calc
    total_mrr = 0
    for tenant_id, usage in _usage_store.items():
        requests = usage["total_requests"]
        if requests > 10000:
            total_mrr += 2499
        elif requests > 2000:
            total_mrr += 499
        elif requests > 100:
            total_mrr += 99

    # Compliance
    total_controls = sum(
        len(fw["controls"]) for fw in _COMPLIANCE_FRAMEWORKS.values()
    )

    # Tenant health
    at_risk = 0
    for usage in _usage_store.values():
        last = usage.get("last_seen")
        if last:
            try:
                hours = (now - datetime.fromisoformat(last)).total_seconds() / 3600
                if hours > 168:
                    at_risk += 1
            except (ValueError, TypeError):
                pass

    return {
        "timestamp": now.isoformat(),
        "executive_summary": {
            "platform_status": "OPERATIONAL" if not _shutting_down else "SHUTTING_DOWN",
            "active_incidents": sum(1 for i in _incidents if i["status"] == "ACTIVE"),
        },
        "revenue": {
            "projected_mrr_usd": total_mrr,
            "projected_arr_usd": total_mrr * 12,
            "total_tenants": len(_usage_store),
            "tenants_at_risk": at_risk,
        },
        "platform_health": {
            "total_requests": total_requests,
            "success_rate": f"{round(success_rate * 100, 2)}%",
            "uptime_hours": round((time.time() - _sla_tracker["start_time"]) / 3600, 1),
            "circuit_breaker": inference_circuit_breaker.state,
            "readiness_indicators": {
                "db": job_store._db_available if hasattr(job_store, '_db_available') else False,
                "audit_chain": audit_logger.verify_chain() in ["VALID", "EMPTY (NO EVENTS)"],
                "no_active_incidents": all(i["status"] != "ACTIVE" for i in _incidents),
            },
        },
        "security_posture": {
            "dlp_detections": sum(_DLP_STATS.values()),
            "canary_alerts": len(_canary_alerts),
            "mitre_techniques_observed": len(set(
                mitre["technique"]
                for action in [e.get("action", "") for e in audit_logger.logs]
                for event_type, mitre in _MITRE_ATTACK_MAP.items()
                if event_type.lower() in action.lower()
            )),
            "audit_events": len(audit_logger.logs),
        },
        "compliance": {
            "frameworks_covered": len(_COMPLIANCE_FRAMEWORKS),
            "controls_mapped": total_controls,
            "compliance_rate": "100%",
        },
    }


