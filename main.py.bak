@app.get("/audit/search")
async def search_audit_events(
    request: Request,
    actor: Optional[str] = None,
    action: Optional[str] = None,
    target: Optional[str] = None,
    from_date: Optional[str] = None,
    to_date: Optional[str] = None,
    limit: int = 50,
    offset: int = 0,
):
    """Search audit events by actor, action, target, and date range."""
    limit, offset = _clamp_pagination(limit, offset)
    user = await verify_jwt(request)
    require_role(user, "search_audit")

    results = []
    for event in audit_logger.logs:
        if actor and event.get("actor") != actor:
            continue
        if action and event.get("action") != action:
            continue
        if target and event.get("target") != target:
            continue
        if from_date:
            try:
                if event["timestamp"] < from_date:
                    continue
            except (KeyError, TypeError):
                continue
        if to_date:
            try:
                if event["timestamp"] > to_date:
                    continue
            except (KeyError, TypeError):
                continue
        results.append(event)

    page = results[offset:offset + limit]

    audit_logger.log(user["user_id"], "SEARCH_AUDIT", "audit_events", "COMPLETED",
                     {"filters": {"actor": actor, "action": action, "target": target,
                                  "from_date": from_date, "to_date": to_date},
                      "results_found": len(results)})

    return {
        "total": len(results),
        "limit": limit,
        "offset": offset,
        "has_more": (offset + limit) < len(results),
        "events": page,
    }


@app.get("/health/ready")
async def readiness_probe():
    """Kubernetes readiness probe — checks if service can accept traffic."""
    if _shutting_down:
        return JSONResponse(status_code=503, content={"ready": False, "reason": "shutting_down"})
    # Check critical dependencies
    checks = {
        "job_store": job_store._db_available or True,  # In-memory fallback is always ready
        "audit_chain": audit_logger.verify_chain() in ["VALID", "EMPTY (NO EVENTS)"],
    }
    all_ready = all(checks.values())
    return JSONResponse(
        status_code=200 if all_ready else 503,
        content={"ready": all_ready, "checks": checks}
    )


@app.get("/health/live")
async def liveness_probe():
    """Kubernetes liveness probe — minimal check that process is alive."""
    return {"alive": True, "pid": os.getpid(), "uptime": "ok"}


@app.get("/health/deep")
async def deep_health_check():
    """Deep health check that verifies subsystem connectivity."""
    from config import config as app_config
    checks = {
        "orchestrator": "HEALTHY",
        "job_store": "persistent" if job_store._db_available else "in-memory",
        "audit_chain": audit_logger.verify_chain(),
        "audit_events": len(audit_logger.logs),
        "inference_url": INFERENCE_URL,
        "model": MODEL_REGISTRY["current"],
        "config": app_config.to_dict(),
        "deployment": "Liberty Center One (OpenStack)",
        "determinism": {"temperature": 0.0, "seed": 42},
        "kill_switch": "ARMED",
        "consensus_model": "3-Way Council (2/3 Majority)",
        "inflight_jobs": sum(1 for v in _inflight_jobs.values() if v),
        "security": {
            "cors": "strict-origin-whitelist",
            "rate_limit": f"{RATE_LIMIT_MAX}/min",
            "csp": "enabled",
            "hsts": "enabled",
            "api_docs": "disabled",
            "request_id": "enabled",
            "graceful_shutdown": "enabled",
            "connection_pool": "50 max",
        },
    }

    # Check inference service reachability (use connection pool)
    try:
        resp = await _http_pool.get(INFERENCE_URL.replace("/generate", "/health"), timeout=5.0)
        checks["inference_service"] = "HEALTHY" if resp.status_code == 200 else "DEGRADED"
    except Exception:
        checks["inference_service"] = "UNREACHABLE (Air-Gapped OK)"

    return checks


@app.websocket("/ws/job/{job_id}")
async def websocket_job_feed(websocket: WebSocket, job_id: str):
    """WebSocket endpoint for real-time job status streaming."""
    # Connection limit per job (prevents resource exhaustion)
    if len(ws_connections.get(job_id, [])) >= MAX_WS_CONNECTIONS_PER_JOB:
        await websocket.close(code=1013, reason="Too many connections for this job")
        return
    await websocket.accept()
    ws_connections[job_id].append(websocket)

    try:
        record = await job_store.get(job_id)
        if record:
            await websocket.send_json({"type": "status_snapshot", "job_id": job_id, **record})

        while True:
            data = await websocket.receive_text()
            if data == "ping":
                await websocket.send_json({"type": "pong"})
    except WebSocketDisconnect:
        ws_connections[job_id].remove(websocket)
    except Exception:
        if websocket in ws_connections.get(job_id, []):
            ws_connections[job_id].remove(websocket)


@app.get("/verify/jobs")
async def list_jobs(
    request: Request,
    status: Optional[str] = None,
    industry: Optional[str] = None,
    tenant_id: Optional[str] = None,
    tag_key: Optional[str] = None,
    tag_value: Optional[str] = None,
    limit: int = 50,
    offset: int = 0,
):
    """List verification jobs with optional filters including tags."""
    user = await verify_jwt(request)
    require_role(user, "list_jobs")
    limit, offset = _clamp_pagination(limit, offset)
    all_jobs = await job_store.list_all()

    # Apply filters
    filtered = {}
    for jid, record in all_jobs.items():
        if status and record.get("status") != status:
            continue
        if industry and record.get("industry") != industry:
            continue
        if tenant_id and record.get("tenant_id", "default") != tenant_id:
            continue
        if tag_key:
            job_tags = record.get("tags", {})
            if tag_key not in job_tags:
                continue
            if tag_value and job_tags.get(tag_key) != tag_value:
                continue
        filtered[jid] = record

    # Pagination
    items = list(filtered.items())
    page = items[offset:offset + limit]

    return {
        "total": len(filtered),
        "limit": limit,
        "offset": offset,
        "has_more": (offset + limit) < len(filtered),
        "jobs": {jid: rec for jid, rec in page},
    }


# ============================================================================
#  BATCH VERIFICATION (Phase 29)
# ============================================================================

class BatchVerificationRequest(BaseModel):
    """Bulk claim verification via JSONL-style list."""
    batches: List[VerificationRequest]


@app.post("/verify/batch", status_code=202)
async def batch_verification(req: BatchVerificationRequest, request: Request, background_tasks: BackgroundTasks):
    """Submit multiple verification jobs at once."""
    user = await verify_jwt(request)
    require_role(user, "batch_submit")
    if len(req.batches) > 20:
        raise HTTPException(status_code=422, detail="Max 20 batches per request.")

    job_ids = []
    for batch in req.batches:
        job_id = str(uuid.uuid4())
        audit_logger.log(user["user_id"], "INITIATE_BATCH_VERIFICATION", job_id, "QUEUED",
                        {"industry": batch.industry, "claim_count": len(batch.claims)})
        background_tasks.add_task(run_verification_job, job_id, batch)
        job_ids.append(job_id)

    logger.info(f"Batch verification: {len(job_ids)} jobs queued by {user['user_id']}")
    return {"batch_size": len(job_ids), "job_ids": job_ids, "status": "queued"}


