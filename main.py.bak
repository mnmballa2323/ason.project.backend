@app.get("/docs/openapi")
async def docs_openapi(request: Request):
    """OpenAPI 3.1.0 specification for the Ason Verification Platform."""
    return {
        "openapi": "3.1.0",
        "info": {
            "title": "Ason Verification Platform API",
            "version": "3.0.0",
            "description": (
                "Enterprise AI verification platform with multi-model consensus, "
                "12-framework compliance mapping, and zero-trust security. "
                "Designed for Fortune 500 / S&P 500 / NASDAQ-100 organizations."
