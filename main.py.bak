@app.on_event("startup")
async def startup_init():
    """Initialize persistent stores and run migrations on application startup."""
    await job_store.initialize()
    await data_sovereignty.initialize()

    # Run database migrations
    try:
        from migrations import migration_runner
        applied = await migration_runner.migrate()
        if applied:
            logger.info(f"Applied {len(applied)} database migrations: {applied}")
    except Exception as e:
        logger.warning(f"Migration skipped (DB may not be available): {e}")

    # Validate configuration
    from config import config
    warnings = config.validate()
    for w in warnings:
        logger.warning(f"CONFIG: {w}")

    logger.info("Ason Verification Orchestrator started (Liberty Center One)")


@app.on_event("shutdown")
async def shutdown_drain():
    """Graceful shutdown: drain connections and wait for in-flight jobs."""
    global _shutting_down
    _shutting_down = True
    logger.info("Shutdown initiated — draining connections...")

    # Wait for in-flight jobs (max 30s)
    for _ in range(60):
        active = sum(1 for v in _inflight_jobs.values() if v)
        if active == 0:
            break
        logger.info(f"Waiting for {active} in-flight job(s)...")
        await asyncio.sleep(0.5)

    # Close connection pool
    await _http_pool.aclose()

    # Close WebSocket connections
    for job_id, ws_list in ws_connections.items():
        for ws in ws_list:
            try:
                await ws.close(code=1001, reason="Server shutting down")
            except Exception:
                pass

    logger.info("Shutdown complete — all connections drained")


