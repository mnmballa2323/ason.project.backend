# ============================================================================
#  WEBHOOK CALLBACK (Internal URLs Only — Per GUARDRAILS.md §2.5)
# ============================================================================

INTERNAL_NETWORKS = [
    ipaddress.ip_network("10.0.0.0/8"),
    ipaddress.ip_network("172.16.0.0/12"),
    ipaddress.ip_network("192.168.0.0/16"),
    ipaddress.ip_network("127.0.0.0/8"),
]
ALLOWED_WEBHOOK_DOMAINS = {"localhost", "libertycenter.one"}


def _validate_webhook_url(url: str) -> bool:
    """Validate webhook URL is internal-only. GUARDRAILS §2.5 enforcement."""
    try:
        from urllib.parse import urlparse
        parsed = urlparse(url)
        hostname = parsed.hostname or ""
        # Check allowed domains
        if any(hostname.endswith(d) for d in ALLOWED_WEBHOOK_DOMAINS):
            return True
        # Check internal IP ranges
        try:
            ip = ipaddress.ip_address(hostname)
            return any(ip in net for net in INTERNAL_NETWORKS)
        except ValueError:
            return False
    except Exception:
        return False


async def _fire_webhook(url: str, payload: dict):
    """POST job result to an internal webhook URL."""
    if not _validate_webhook_url(url):
        logger.warning(f"Webhook URL rejected (not internal): {url}")
        return
    try:
        async with httpx.AsyncClient() as client:
            resp = await client.post(url, json=payload, timeout=10.0)
            logger.info(f"Webhook delivered", extra={"url": url, "status": resp.status_code})
    except Exception as e:
        logger.error(f"Webhook delivery failed", extra={"url": url, "error": str(e)})


