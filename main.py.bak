        "total_jobs": store["total_jobs"],
        "first_seen": store["first_seen"],
        "last_seen": store["last_seen"],
        "top_endpoints": dict(sorted(
            store["endpoints"].items(), key=lambda x: x[1], reverse=True
        )[:15]),
        "exported_at": datetime.now(timezone.utc).isoformat(),
    }


@app.get("/admin/usage/report")
async def aggregate_usage_report(request: Request):
    """Aggregate usage report across all tenants. Admin-only."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    tenant_summaries = []
    total_requests = 0
    for tenant_id, store in _usage_store.items():
        total_requests += store["total_requests"]
        tenant_summaries.append({
            "tenant_id": tenant_id,
            "total_requests": store["total_requests"],
            "total_jobs": store["total_jobs"],
            "last_seen": store["last_seen"],
        })

    # Sort by volume
    tenant_summaries.sort(key=lambda x: x["total_requests"], reverse=True)

    return {
        "report_type": "aggregate_usage",
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "total_tenants": len(_usage_store),
        "total_requests": total_requests,
        "tenants": tenant_summaries[:50],
        "billing_period": {
            "start": min((s["first_seen"] for s in _usage_store.values() if s["first_seen"]), default=None),
            "end": datetime.now(timezone.utc).isoformat(),
        },
    }


# ============================================================================
#  SLA COMPLIANCE MONITORING (Wave 12)
# ============================================================================

@app.get("/system/sla")
async def sla_compliance(request: Request):
    """Real-time SLA compliance monitoring. Admin-only."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    latencies = _sla_tracker["latencies_ms"]
    successes = _sla_tracker["successes"]
    failures = _sla_tracker["failures"]
    total = successes + failures
    uptime_seconds = time.time() - _sla_tracker["start_time"]

    # SLA targets from config
    target_p99_ms = float(os.getenv("SLA_TARGET_P99_MS", "30000"))
    target_success_rate = float(os.getenv("SLA_TARGET_SUCCESS_RATE", "0.995"))

    # Compute actuals
    success_rate = successes / total if total > 0 else 1.0
    p99_ms = sorted(latencies)[int(len(latencies) * 0.99)] if len(latencies) > 10 else 0
    p95_ms = sorted(latencies)[int(len(latencies) * 0.95)] if len(latencies) > 10 else 0
    p50_ms = sorted(latencies)[int(len(latencies) * 0.50)] if len(latencies) > 1 else 0
    avg_ms = sum(latencies) / len(latencies) if latencies else 0

    # SLA compliance checks
    p99_compliant = p99_ms <= target_p99_ms
    rate_compliant = success_rate >= target_success_rate
    overall_compliant = p99_compliant and rate_compliant

    # Auto-detect SLA breach
    if not overall_compliant and total > 100:
        audit_logger.log("system", "SLA_BREACH_DETECTED", "sla_monitor", "WARNING",
                         {"success_rate": round(success_rate, 4), "p99_ms": round(p99_ms, 2)})

    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "uptime_seconds": round(uptime_seconds, 0),
        "overall_compliant": overall_compliant,
        "targets": {
            "p99_latency_ms": target_p99_ms,
            "success_rate": target_success_rate,
        },
        "actuals": {
            "total_requests": total,
            "successes": successes,
            "failures": failures,
            "success_rate": round(success_rate, 6),
            "p50_ms": round(p50_ms, 2),
            "p95_ms": round(p95_ms, 2),
            "p99_ms": round(p99_ms, 2),
            "avg_ms": round(avg_ms, 2),
        },
        "compliance": {
            "p99_compliant": p99_compliant,
            "success_rate_compliant": rate_compliant,
        },
    }


# ============================================================================
#  INCIDENT RESPONSE (Wave 13)
# ============================================================================

class IncidentRequest(BaseModel):
    severity: str = "P2"  # P1 (critical) to P4 (low)
    title: str
    description: str = ""
    affected_components: List[str] = []


@app.post("/admin/incident/declare")
async def declare_incident(req: IncidentRequest, request: Request):
    """Formally declare an incident. Admin-only. Audit-logged."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    if req.severity not in ["P1", "P2", "P3", "P4"]:
        raise HTTPException(status_code=422, detail="Severity must be P1, P2, P3, or P4.")
    if len(req.title) > 200:
        raise HTTPException(status_code=422, detail="Title must be 200 chars or less.")

    incident = {
        "incident_id": f"INC-{str(uuid.uuid4())[:8].upper()}",
        "severity": req.severity,
        "title": req.title,
        "description": req.description,
        "affected_components": req.affected_components,
        "status": "ACTIVE",
        "declared_by": user["user_id"],
        "declared_at": datetime.now(timezone.utc).isoformat(),
        "resolved_at": None,
        "resolved_by": None,
        "resolution_notes": None,
        "duration_minutes": None,
    }
    _incidents.append(incident)

    audit_logger.log(user["user_id"], "INCIDENT_DECLARED", incident["incident_id"], "ACTIVE",
                     {"severity": req.severity, "title": req.title})

    logger.warning(f"INCIDENT DECLARED: {incident['incident_id']} [{req.severity}] {req.title}")

    return incident


@app.get("/admin/incident/active")
async def list_active_incidents(request: Request):
    """List all active (unresolved) incidents."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    active = [inc for inc in _incidents if inc["status"] == "ACTIVE"]
    return {
        "total_active": len(active),
        "incidents": active,
        "timestamp": datetime.now(timezone.utc).isoformat(),
    }


@app.get("/admin/incident/history")
async def incident_history(request: Request):
    """Full incident history — active and resolved."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    return {
        "total": len(_incidents),
        "active": sum(1 for i in _incidents if i["status"] == "ACTIVE"),
        "resolved": sum(1 for i in _incidents if i["status"] == "RESOLVED"),
        "incidents": _incidents,
        "timestamp": datetime.now(timezone.utc).isoformat(),
    }


class ResolveRequest(BaseModel):
    resolution_notes: str = ""


@app.post("/admin/incident/resolve/{incident_id}")
async def resolve_incident(incident_id: str, req: ResolveRequest, request: Request):
    """Resolve an active incident. Admin-only. Audit-logged."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    for inc in _incidents:
        if inc["incident_id"] == incident_id:
            if inc["status"] == "RESOLVED":
                raise HTTPException(status_code=409, detail="Incident already resolved.")

            now = datetime.now(timezone.utc)
            declared_at = datetime.fromisoformat(inc["declared_at"])
            duration = (now - declared_at).total_seconds() / 60

            inc["status"] = "RESOLVED"
            inc["resolved_at"] = now.isoformat()
            inc["resolved_by"] = user["user_id"]
            inc["resolution_notes"] = req.resolution_notes
            inc["duration_minutes"] = round(duration, 1)

            audit_logger.log(user["user_id"], "INCIDENT_RESOLVED", incident_id, "RESOLVED",
                             {"duration_minutes": inc["duration_minutes"]})

            return inc

    raise HTTPException(status_code=404, detail=f"Incident '{incident_id}' not found.")


# ============================================================================
#  DEPLOYMENT READINESS SCORE (Wave 14)
# ============================================================================

@app.get("/system/readiness-score")
async def deployment_readiness_score(request: Request):
    """Self-assessment deployment readiness score (0-100). Admin-only.
    Blocks deploy recommendation if score < 80."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    checks = []
    total_score = 0
    max_score = 0

    # --- Infrastructure (25 points) ---
    db_ok = job_store._db_available if hasattr(job_store, '_db_available') else False
    checks.append({"category": "infrastructure", "check": "database_connected", "passed": db_ok, "points": 10})
    total_score += 10 if db_ok else 0
    max_score += 10

    shutting = _shutting_down
    checks.append({"category": "infrastructure", "check": "not_shutting_down", "passed": not shutting, "points": 5})
    total_score += 5 if not shutting else 0
    max_score += 5

    cb_ok = inference_circuit_breaker.state != "open"
    checks.append({"category": "infrastructure", "check": "circuit_breaker_closed", "passed": cb_ok, "points": 10})
    total_score += 10 if cb_ok else 0
    max_score += 10

    # --- Security (30 points) ---
    env = os.getenv("ASON_ENV", "development")
    is_prod = env == "production"

    rbac_ok = len(RBAC_MATRIX) >= 5
    checks.append({"category": "security", "check": "rbac_configured", "passed": rbac_ok, "points": 10})
    total_score += 10 if rbac_ok else 0
    max_score += 10

    ip_ok = len(IP_ALLOWLIST) > 0 if is_prod else True
    checks.append({"category": "security", "check": "ip_allowlist_configured", "passed": ip_ok, "points": 10})
    total_score += 10 if ip_ok else 0
    max_score += 10

    tls_ok = os.getenv("ASON_TLS_ENABLED", "false").lower() == "true" if is_prod else True
    checks.append({"category": "security", "check": "tls_enabled", "passed": tls_ok, "points": 10})
    total_score += 10 if tls_ok else 0
    max_score += 10

    # --- Compliance (25 points) ---
    chain_ok = audit_logger.verify_chain() in ["VALID", "EMPTY (NO EVENTS)"]
    checks.append({"category": "compliance", "check": "audit_chain_intact", "passed": chain_ok, "points": 15})
    total_score += 15 if chain_ok else 0
    max_score += 15

    sbom_ok = _generate_sbom() is not None
    checks.append({"category": "compliance", "check": "sbom_available", "passed": sbom_ok, "points": 10})
    total_score += 10 if sbom_ok else 0
    max_score += 10

    # --- Performance (20 points) ---
    latencies = _sla_tracker["latencies_ms"]
    has_traffic = len(latencies) > 0
    checks.append({"category": "performance", "check": "traffic_observed", "passed": has_traffic, "points": 5})
    total_score += 5 if has_traffic else 0
    max_score += 5

    no_active_incidents = all(i["status"] != "ACTIVE" for i in _incidents)
    checks.append({"category": "performance", "check": "no_active_incidents", "passed": no_active_incidents, "points": 10})
    total_score += 10 if no_active_incidents else 0
    max_score += 10

    sla_ok = True
    if len(latencies) > 100:
        successes = _sla_tracker["successes"]
        total = successes + _sla_tracker["failures"]
        sla_ok = (successes / total) >= 0.99 if total > 0 else True
    checks.append({"category": "performance", "check": "sla_compliance", "passed": sla_ok, "points": 5})
    total_score += 5 if sla_ok else 0
    max_score += 5

    score = round((total_score / max_score) * 100) if max_score > 0 else 0
    deploy_ready = score >= 80

    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "score": score,
        "max_score": 100,
        "deploy_recommended": deploy_ready,
        "verdict": "READY FOR PRODUCTION" if deploy_ready else "NOT READY — address failing checks",
        "breakdown": {
            "infrastructure": sum(c["points"] for c in checks if c["category"] == "infrastructure" and c["passed"]),
            "security": sum(c["points"] for c in checks if c["category"] == "security" and c["passed"]),
            "compliance": sum(c["points"] for c in checks if c["category"] == "compliance" and c["passed"]),
            "performance": sum(c["points"] for c in checks if c["category"] == "performance" and c["passed"]),
        },
        "checks": checks,
        "failing": [c for c in checks if not c["passed"]],
    }


# ============================================================================
#  CRYPTOGRAPHIC INTEGRITY (Wave 15)
# ============================================================================

_HMAC_SECRET = os.getenv("ASON_HMAC_SECRET", hashlib.sha256(b"ason-lc1-default-dev-key").hexdigest())
_NONCE_STORE: Set[str] = set()  # Replay protection
_NONCE_MAX_AGE = 300  # 5 minute nonce window
_nonce_timestamps: Dict[str, float] = {}


@app.post("/admin/audit/export/signed")
async def signed_audit_export(request: Request):
    """Export audit logs with cryptographic chain signature. Admin-only.
    Each segment includes a rolling HMAC — breaking any entry invalidates the chain."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    events = audit_logger.logs
    chain_status = audit_logger.verify_chain()

    # Create signed export with rolling HMAC
    signed_events = []
    rolling_hash = "GENESIS"
    for event in events:
        event_data = json.dumps(event, sort_keys=True, default=str)
        rolling_hash = hashlib.sha256(f"{rolling_hash}:{event_data}".encode()).hexdigest()
        signed_events.append({**event, "_chain_hash": rolling_hash})

    # Final attestation
    export_signature = hashlib.sha256(
        f"{_HMAC_SECRET}:{rolling_hash}:{len(events)}:{chain_status}".encode()
    ).hexdigest()

    audit_logger.log(user["user_id"], "SIGNED_AUDIT_EXPORT", "audit_chain", "COMPLETED",
                     {"events_exported": len(events), "signature": export_signature[:16]})

    return {
        "export_type": "signed_audit_chain",
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "generated_by": user["user_id"],
        "chain_integrity": chain_status,
        "total_events": len(events),
        "events": signed_events,
        "attestation": {
            "algorithm": "SHA-256 Rolling HMAC",
            "final_hash": rolling_hash,
            "export_signature": export_signature,
            "verification": "Replay chain from GENESIS. Any mismatch = tampering.",
        },
    }


@app.get("/system/nonce")
async def get_nonce():
    """Generate a one-time nonce for replay-protected requests.
    Clients include this nonce in submitted requests to prevent replay attacks."""
    nonce = f"{uuid.uuid4()}-{int(time.time())}"
    _NONCE_STORE.add(nonce)
    _nonce_timestamps[nonce] = time.time()

    # Prune expired nonces
    now = time.time()
    expired = [n for n, ts in _nonce_timestamps.items() if now - ts > _NONCE_MAX_AGE]
    for n in expired:
        _NONCE_STORE.discard(n)
        _nonce_timestamps.pop(n, None)

    return {"nonce": nonce, "expires_in_seconds": _NONCE_MAX_AGE}


def _validate_nonce(nonce: str) -> bool:
    """Validate and consume a one-time nonce. Returns False if replayed."""
    if nonce not in _NONCE_STORE:
        return False
    if time.time() - _nonce_timestamps.get(nonce, 0) > _NONCE_MAX_AGE:
        _NONCE_STORE.discard(nonce)
        _nonce_timestamps.pop(nonce, None)
        return False
    _NONCE_STORE.discard(nonce)
    _nonce_timestamps.pop(nonce, None)
    return True


# ============================================================================
#  DATA LOSS PREVENTION ENGINE (Wave 16)
# ============================================================================

_DLP_PATTERNS = {
    "SSN": re.compile(r'\b\d{3}-\d{2}-\d{4}\b'),
    "CREDIT_CARD": re.compile(r'\b(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|3[47][0-9]{13}|6(?:011|5[0-9]{2})[0-9]{12})\b'),
    "PHONE_US": re.compile(r'\b(?:\+1[-.\s]?)?\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}\b'),
    "EMAIL": re.compile(r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b'),
    "IP_ADDRESS": re.compile(r'\b(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\.(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\.(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\.(?:25[0-5]|2[0-4]\d|[01]?\d\d?)\b'),
    "AWS_KEY": re.compile(r'\b(?:AKIA|ABIA|ACCA|ASIA)[0-9A-Z]{16}\b'),
    "PRIVATE_KEY": re.compile(r'-----BEGIN (?:RSA |EC )?PRIVATE KEY-----'),
}
_DLP_STATS: Dict[str, int] = defaultdict(int)


def _dlp_scan(text: str) -> Dict[str, int]:
    """Scan text for PII/PHI/secrets. Returns dict of {pattern_name: count}."""
    findings = {}
    for name, pattern in _DLP_PATTERNS.items():
        matches = pattern.findall(text)
        if matches:
            findings[name] = len(matches)
            _DLP_STATS[name] += len(matches)
    return findings


def _dlp_redact(text: str) -> str:
    """Redact detected PII/sensitive data from text."""
    for name, pattern in _DLP_PATTERNS.items():
        text = pattern.sub(f"[REDACTED-{name}]", text)
    return text


@app.get("/system/dlp/stats")
async def dlp_statistics(request: Request):
    """DLP detection statistics. Admin-only."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "total_detections": sum(_DLP_STATS.values()),
        "by_category": dict(_DLP_STATS),
        "patterns_active": list(_DLP_PATTERNS.keys()),
        "auto_redaction": True,
        "classification_levels": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"],
    }


@app.post("/system/dlp/scan")
async def dlp_scan_text(request: Request):
    """Scan arbitrary text for PII/sensitive data. Admin-only."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    body = await request.json()
    text = body.get("text", "")
    if len(text) > 50000:
        raise HTTPException(status_code=422, detail="Text must be 50,000 chars or less.")

    findings = _dlp_scan(text)
    redacted = _dlp_redact(text)

    # Classify sensitivity
    if any(k in findings for k in ["PRIVATE_KEY", "AWS_KEY"]):
        classification = "RESTRICTED"
    elif any(k in findings for k in ["SSN", "CREDIT_CARD"]):
        classification = "CONFIDENTIAL"
    elif any(k in findings for k in ["EMAIL", "PHONE_US", "IP_ADDRESS"]):
        classification = "INTERNAL"
    else:
        classification = "PUBLIC"

    return {
        "classification": classification,
        "findings": findings,
        "total_detections": sum(findings.values()),
        "redacted_text": redacted if findings else None,
    }


