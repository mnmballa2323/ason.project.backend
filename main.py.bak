            {"url": "http://localhost:8000", "description": "Local development"},
        ],
        "tags": [
            {"name": "Verification", "description": "Submit and track AI verification jobs"},
            {"name": "Models", "description": "Model registry ans configuration"},
            {"name": "Security", "description": "Security controls, DLP, pen testing"},
            {"name": "Compliance", "description": "Framework mapping and audit reports"},
            {"name": "Dashboards", "description": "Executive security, compliance, and ops dashboards"},
            {"name": "Onboarding", "description": "Self-service tenant provisioning"},
