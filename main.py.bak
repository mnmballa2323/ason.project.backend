        "timestamp": datetime.now(timezone.utc).isoformat(),
        "total_plans": len(_RATE_PLANS),
        "plans": _RATE_PLANS,
    }


@app.get("/admin/billing/revenue-projection")
async def revenue_projection(request: Request):
    """Revenue projection based on current tenant usage. Admin-only.
    Maps tenant usage volume to recommended rate plans."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    projections = []
    total_mrr = 0

    for tenant_id, usage in _usage_store.items():
        requests = usage["total_requests"]

        # Auto-classify tenant into tier based on usage
        if requests > 10000:
            tier = "enterprise"
        elif requests > 2000:
            tier = "professional"
        elif requests > 100:
            tier = "starter"
        else:
            tier = "free"

        plan = _RATE_PLANS[tier]
        mrr = plan["price_monthly_usd"]
        total_mrr += mrr

        projections.append({
            "tenant_id": tenant_id,
            "total_requests": requests,
            "recommended_tier": tier,
            "monthly_revenue_usd": mrr,
        })

    projections.sort(key=lambda x: x["monthly_revenue_usd"], reverse=True)

    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "projected_mrr_usd": total_mrr,
        "projected_arr_usd": total_mrr * 12,
        "total_tenants": len(projections),
        "tier_distribution": {
            tier: sum(1 for p in projections if p["recommended_tier"] == tier)
            for tier in _RATE_PLANS
        },
        "projections": projections[:50],
    }


