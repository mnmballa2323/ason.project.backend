# MITRE ATT&CK Mapping for security events
_MITRE_ATTACK_MAP = {
    "RATE_LIMIT_EXCEEDED": {"tactic": "Impact", "technique": "T1499", "name": "Endpoint Denial of Service"},
    "AUTH_FAILURE": {"tactic": "Credential Access", "technique": "T1110", "name": "Brute Force"},
    "INVALID_JWT": {"tactic": "Defense Evasion", "technique": "T1550", "name": "Use Alternate Authentication Material"},
    "RBAC_VIOLATION": {"tactic": "Privilege Escalation", "technique": "T1548", "name": "Abuse Elevation Control"},
    "PATH_TRAVERSAL": {"tactic": "Collection", "technique": "T1005", "name": "Data from Local System"},
    "SQL_INJECTION": {"tactic": "Initial Access", "technique": "T1190", "name": "Exploit Public-Facing Application"},
    "OVERSIZED_PAYLOAD": {"tactic": "Impact", "technique": "T1499.003", "name": "Application Exhaustion Flood"},
    "PII_DETECTED": {"tactic": "Collection", "technique": "T1530", "name": "Data from Cloud Storage"},
    "REPLAY_ATTACK": {"tactic": "Credential Access", "technique": "T1550.004", "name": "Web Session Cookie Replay"},
    "WS_FLOOD": {"tactic": "Impact", "technique": "T1499.002", "name": "Service Exhaustion Flood"},
    "CIRCUIT_BREAKER_OPEN": {"tactic": "Impact", "technique": "T1489", "name": "Service Stop"},
}

# Canary tokens — synthetic resources that should never be accessed
_CANARY_TOKENS = {
    "admin-backup-2024": "Fake admin credential canary",
    "db-migration-key": "Fake database key canary",
    "internal-api-secret": "Fake API secret canary",
}
_canary_alerts: List[dict] = []


@app.get("/admin/security/threat-map")
async def security_threat_map(request: Request):
    """MITRE ATT&CK mapped threat landscape from observed events. Admin-only."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    # Scan audit logs for security events
    threat_events = []
    tactic_counts: Dict[str, int] = defaultdict(int)

    for event in audit_logger.logs:
        action = event.get("action", "")
        for event_type, mitre in _MITRE_ATTACK_MAP.items():
            if event_type.lower() in action.lower():
                tactic_counts[mitre["tactic"]] += 1
                threat_events.append({
                    "timestamp": event.get("timestamp"),
                    "action": action,
                    "mitre_tactic": mitre["tactic"],
                    "mitre_technique": mitre["technique"],
                    "mitre_name": mitre["name"],
                })

    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "framework": "MITRE ATT&CK v14",
        "total_mapped_events": len(threat_events),
        "tactic_distribution": dict(tactic_counts),
        "techniques_observed": list(set(e["mitre_technique"] for e in threat_events)),
        "recent_threats": threat_events[-20:],  # Last 20
        "canary_alerts": len(_canary_alerts),
        "threat_level": "HIGH" if len(threat_events) > 50 else "MEDIUM" if len(threat_events) > 10 else "LOW",
    }


@app.get("/admin/audit/export/cef")
async def export_audit_cef(request: Request):
    """Export audit logs in CEF (Common Event Format) for SIEM ingestion. Admin-only."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    cef_lines = []
    for event in audit_logger.logs:
        severity = 5  # Default medium
        action = event.get("action", "")
        if any(k in action for k in ["VIOLATION", "BREACH", "INCIDENT"]):
            severity = 9
        elif any(k in action for k in ["WARNING", "FAILURE"]):
            severity = 7

        cef = (
            f"CEF:0|Ason|VerificationPlatform|2.0.0|{action}|"
            f"{event.get('action', 'UNKNOWN')}|{severity}|"
            f"src={event.get('user', 'system')} "
            f"dst={event.get('target', 'N/A')} "
            f"outcome={event.get('result', 'UNKNOWN')} "
            f"rt={event.get('timestamp', '')}"
        )
        cef_lines.append(cef)

    audit_logger.log(user["user_id"], "CEF_EXPORT", "audit_chain", "COMPLETED",
                     {"events_exported": len(cef_lines)})

    return {
        "format": "CEF (Common Event Format)",
        "compatible_with": ["Splunk", "QRadar", "ArcSight", "Sentinel", "Elastic SIEM"],
        "total_events": len(cef_lines),
        "cef_data": cef_lines,
        "exported_at": datetime.now(timezone.utc).isoformat(),
    }


@app.get("/system/canary/{token}")
async def canary_endpoint(token: str, request: Request):
    """Canary token trap. Any access = unauthorized probing detected."""
    client_ip = request.client.host if request.client else "unknown"

    alert = {
        "alert_type": "CANARY_TOKEN_TRIGGERED",
        "token": token,
        "description": _CANARY_TOKENS.get(token, "Unknown canary"),
        "client_ip": client_ip,
        "user_agent": request.headers.get("User-Agent", "unknown"),
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "severity": "CRITICAL",
    }
    _canary_alerts.append(alert)
    audit_logger.log("CANARY_SYSTEM", "CANARY_TOKEN_TRIGGERED", token, "CRITICAL",
                     {"ip": client_ip, "token": token})
    logger.critical(f"CANARY TRIGGERED: {token} from {client_ip}")

    # Return innocuous 404 to not reveal it's a canary
    raise HTTPException(status_code=404, detail="Not found.")


