@app.get("/admin/compliance/frameworks")
async def compliance_framework_map(request: Request):
    """Master compliance mapping — all frameworks with control-to-feature evidence.
    The 'Compliance Rosetta Stone'. Admin-only."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    # Compute summary stats
    total_controls = 0
    implemented = 0
    for fw in _COMPLIANCE_FRAMEWORKS.values():
        for ctrl in fw["controls"].values():
            total_controls += 1
            if ctrl["status"] == "IMPLEMENTED":
                implemented += 1

    audit_logger.log(user["user_id"], "COMPLIANCE_FRAMEWORK_EXPORT", "all_frameworks", "ACCESSED")

    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "total_frameworks": len(_COMPLIANCE_FRAMEWORKS),
        "total_controls_mapped": total_controls,
        "controls_implemented": implemented,
        "compliance_rate": f"{round((implemented/total_controls)*100, 1)}%",
        "frameworks": _COMPLIANCE_FRAMEWORKS,
    }


@app.get("/admin/compliance/framework/{framework_id}")
async def get_framework_detail(framework_id: str, request: Request):
    """Get detailed controls for a specific compliance framework."""
    user = await verify_jwt(request)
    require_role(user, "admin_config")

    fw = _COMPLIANCE_FRAMEWORKS.get(framework_id.upper())
    if not fw:
        available = list(_COMPLIANCE_FRAMEWORKS.keys())
        raise HTTPException(status_code=404, detail=f"Framework '{framework_id}' not found. Available: {available}")

    total = len(fw["controls"])
    impl = sum(1 for c in fw["controls"].values() if c["status"] == "IMPLEMENTED")

    return {
        "framework_id": framework_id.upper(),
        "name": fw["name"],
        "authority": fw["authority"],
        "total_controls": total,
        "implemented": impl,
        "compliance_rate": f"{round((impl/total)*100, 1)}%",
        "controls": fw["controls"],
    }


