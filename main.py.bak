@app.post("/verify/cancel/{job_id}")
async def cancel_job(job_id: str, request: Request):
    """Cancel a running verification job."""
    user = await verify_jwt(request)
    require_role(user, "cancel_job")
    record = await job_store.get(job_id)
    if not record:
        raise HTTPException(status_code=404, detail="Job not found.")
    if record.get("status") in ("completed", "failed", "cancelled"):
        raise HTTPException(status_code=409, detail=f"Job already {record['status']}.")

    _cancelled_jobs.add(job_id)
    await job_store.update(job_id, status="cancelling")
    audit_logger.log(user["user_id"], "CANCEL_JOB", job_id, "CANCELLING",
                     {"previous_status": record.get("status")})
    logger.info(f"Job {job_id} cancellation requested by {user['user_id']}")
    return {"job_id": job_id, "status": "cancelling"}


@app.get("/verify/report/{job_id}")
async def get_compliance_report(job_id: str, request: Request):
    """Generate a structured compliance report for a completed job."""
    user = await verify_jwt(request)
    require_role(user, "view_report")
    record = await job_store.get(job_id)
    if not record:
        raise HTTPException(status_code=404, detail="Job not found.")
    if record.get("status") != "completed":
        raise HTTPException(status_code=409, detail=f"Job not completed (status: {record.get('status')}).")

    # Collect related audit events
    job_events = [e for e in audit_logger.logs if e.get("target") == job_id]

    audit_logger.log(user["user_id"], "EXPORT_REPORT", job_id, "GENERATED")

    return {
        "report_type": "compliance_verification",
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "generated_by": user["user_id"],
        "deployment": "Liberty Center One (Private OpenStack)",
        "model": MODEL_REGISTRY["current"],
        "determinism": {"temperature": 0.0, "seed": 42, "engine": "vLLM (self-hosted)"},
        "job": {
            "job_id": job_id,
            "industry": record.get("industry"),
            "total_claims": record.get("total_claims"),
            "status": record.get("status"),
            "result": record.get("result"),
            "started_at": record.get("started_at"),
            "completed_at": record.get("completed_at"),
            "model_version": record.get("model_version"),
            "tags": record.get("tags", {}),
        },
        "audit_trail": {
            "chain_integrity": audit_logger.verify_chain(),
            "events": job_events,
        },
        "attestation": {
            "statement": "This report was generated by a self-hosted Ason-72B model with deterministic inference. "
                         "No data was transmitted to any external service. All evidence was processed on-premise.",
            "hash": hashlib.sha256(json.dumps(record, default=str, sort_keys=True).encode()).hexdigest(),
        },
    }


