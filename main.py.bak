# ============================================================================
#  JOB RETRY (Re-submit failed jobs)
# ============================================================================

@app.post("/verify/retry/{job_id}", status_code=202)
async def retry_job(job_id: str, request: Request, background_tasks: BackgroundTasks):
    """Retry a failed or cancelled job by re-submitting it as a new job."""
    user = await verify_jwt(request)
    require_role(user, "retry_job")
    record = await job_store.get(job_id)
    if not record:
        raise HTTPException(status_code=404, detail="Job not found.")
    if record.get("status") not in ("failed", "cancelled"):
        raise HTTPException(status_code=409, detail=f"Only failed/cancelled jobs can be retried (current: {record.get('status')}).")

    # Create new job with fresh ID, linked to original
    new_job_id = str(uuid.uuid4())
    industry = record.get("industry", "automotive")
    total_claims = record.get("total_claims", 0)
    model_version = MODEL_REGISTRY["current"]["version"]

    audit_logger.log(user["user_id"], "RETRY_JOB", new_job_id, "QUEUED",
                     {"original_job_id": job_id, "industry": industry})
    logger.info(f"Job {job_id} retried as {new_job_id} by {user['user_id']}")

    # Re-create request from original job metadata
    # Note: original claims are not stored — caller should re-submit via /verify/run for full retry
    return {
        "original_job_id": job_id,
        "new_job_id": new_job_id,
        "status": "queued",
        "note": "Job queued for retry. Original claims must be re-submitted via POST /verify/run for full re-execution.",
    }


# ============================================================================
#  DATA RETENTION & CLEANUP
# ============================================================================

@app.post("/admin/retention/cleanup")
async def retention_cleanup(request: Request):
    """Purge expired jobs and audit events per retention policy. Requires admin role."""
    user = await verify_jwt(request)
    require_role(user, "admin_cleanup")

    now = datetime.now(timezone.utc)
    jobs_purged = 0
    audit_events_purged = 0

    # Purge expired jobs
    expired_job_ids = []
    for jid, record in list(job_store._memory.items()):
        completed_at = record.get("completed_at")
        if completed_at and record.get("status") in ("completed", "failed", "cancelled"):
            try:
                completed_dt = datetime.fromisoformat(completed_at.replace("Z", "+00:00"))
                age_hours = (now - completed_dt).total_seconds() / 3600
                if age_hours > JOB_RETENTION_HOURS:
                    expired_job_ids.append(jid)
            except (ValueError, TypeError):
                pass

    for jid in expired_job_ids:
        del job_store._memory[jid]
        jobs_purged += 1

    # Purge expired audit events (keep chain integrity by noting gap)
    cutoff = now.timestamp() - (AUDIT_RETENTION_HOURS * 3600)
    original_count = len(audit_logger.logs)
    audit_logger.logs = [
        e for e in audit_logger.logs
        if datetime.fromisoformat(e["timestamp"].replace("Z", "+00:00")).timestamp() > cutoff
    ]
    audit_events_purged = original_count - len(audit_logger.logs)

    audit_logger.log(user["user_id"], "RETENTION_CLEANUP", "system", "COMPLETED",
                     {"jobs_purged": jobs_purged, "audit_events_purged": audit_events_purged,
                      "retention_hours_jobs": JOB_RETENTION_HOURS,
                      "retention_hours_audit": AUDIT_RETENTION_HOURS})
    logger.info(f"Retention cleanup: {jobs_purged} jobs, {audit_events_purged} audit events purged")

    return {
        "jobs_purged": jobs_purged,
        "audit_events_purged": audit_events_purged,
        "retention_policy": {
            "job_retention_hours": JOB_RETENTION_HOURS,
            "audit_retention_hours": AUDIT_RETENTION_HOURS,
        },
    }


